# Copy this file to .env and fill in the values: cp .env.example .env
# All variables marked (required) must be set or the app fails on startup.

# (required) PostgreSQL connection string (SQLAlchemy format, psycopg2 driver).
# Point it at the "weather_app" database that app/create_database.py creates.
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/weather_app

# (required) Secret used to sign JWT access tokens. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# (required) JWT signing algorithm
JWT_ALGORITHM=HS256

# (required) Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# (required) Open-Meteo endpoints (free, no API key needed)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# (optional) Timeout in seconds for outbound geocoding requests. Defaults to 10.0
# HTTP_TIMEOUT_SECONDS=10.0
